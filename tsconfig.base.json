{
	"compileOnSave": false,
	"compilerOptions": {
		"rootDir": ".",
		"sourceMap": true,
		"declaration": false,
		"moduleResolution": "node",
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"importHelpers": true,
		"target": "es2015",
		"module": "esnext",
		"lib": ["es2020", "dom"],
		"skipLibCheck": true,
		"skipDefaultLibCheck": true,
		"baseUrl": ".",
		"paths": {
			"@fiap-farm/dashboard-hub": ["libs/dashboard/feature-hub/src/index.ts"],
			"@fiap-farm/login": ["libs/auth/feature-login/src/index.ts"],
			"@fiap-farm/register": ["libs/auth/feature-register/src/index.ts"],
			"@fiap-farm/ui-components": ["libs/shared/ui-components/src/index.ts"],
			"@fiap-hackaton/auth-data-access": ["libs/auth/data-access/src/index.ts"],
			"@fiap-hackaton/auth-domain": ["libs/auth/domain/src/index.ts"],
			"@fiap-hackaton/dashboard-data-access": ["libs/dashboard/data-access/src/index.ts"],
			"@fiap-hackaton/dashboard-domain": ["libs/dashboard/domain/src/index.ts"],
			"@fiap-hackaton/dashboard-feature-analytics": ["libs/dashboard/feature-analytics/src/index.ts"],
			"@fiap-hackaton/dashboard-feature-harvest": ["libs/dashboard/feature-harvest/src/index.ts"],
			"@fiap-hackaton/dashboard-feature-plantings": ["libs/dashboard/feature-plantings/src/index.ts"],
			"@fiap-hackaton/dashboard-feature-products": ["libs/dashboard/feature-products/src/index.ts"],
			"@fiap-hackaton/dashboard-feature-sales": ["libs/dashboard/feature-sales/src/index.ts"],
			"@fiap-hackaton/data-access": ["libs/map/data-access/src/index.ts"],
			"@fiap-hackaton/domain": ["libs/map/domain/src/index.ts"],
			"@fiap-hackaton/map-data-access": ["libs/map/data-access/src/index.ts"],
			"@fiap-hackaton/map-domain": ["libs/map/domain/src/index.ts"],
			"@fiap-hackaton/map-feature-viewer": ["libs/map/feature-viewer/src/index.ts"],
			"@fiap-hackaton/map-ui": ["libs/map/ui/src/index.ts"],
			"@fiap-hackaton/map-util": ["libs/map/util/src/index.ts"],
			"@fiap-hackaton/shared-data-access": ["libs/shared/data-access/src/index.ts"],
			"@fiap-hackaton/shared-environments": ["libs/shared/environments/src/index.ts"],
			"@fiap-hackaton/shared-ui": ["libs/shared/ui/src/index.ts"],
			"@fiap-hackaton/shell-dashboard": ["libs/shell/dashboard/src/index.ts"],
			"@fiap-hackaton/shell-map": ["libs/shell/map/src/index.ts"],
			"map/Routes": ["apps/map/src/app/remote-entry/entry.routes.ts"]
		}
	},
	"exclude": ["node_modules", "tmp"]
}
