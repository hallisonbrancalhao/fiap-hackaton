rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // COLEÇÕES DE MAPAS - Leitura Pública
    // ========================================
    // Permite acesso público aos dados de mapas para integração mobile
    // Apenas leitura é permitida sem autenticação

    // Farm Areas - Polígonos das fazendas
    match /farmAreas/{farmAreaId} {
      allow read: if true;  // ✅ Leitura pública
      allow write: if request.auth != null;  // ✅ Escrita protegida
    }

    // Production Areas - Áreas de produção/plantio
    match /productionAreas/{productionAreaId} {
      allow read: if true;  // ✅ Leitura pública
      allow write: if request.auth != null;  // ✅ Escrita protegida
    }

    // Planting Plots - Talhões de plantio
    match /plantingPlots/{plotId} {
      allow read: if true;  // ✅ Leitura pública
      allow write: if request.auth != null;  // ✅ Escrita protegida
    }

    // ========================================
    // OUTRAS COLEÇÕES - Requerem Autenticação
    // ========================================
    // Dados sensíveis (usuários, vendas, custos, etc)
    // Requerem autenticação para leitura e escrita

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
